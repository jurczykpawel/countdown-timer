{
    "_comment": "Remote bgImage URLs are denied by default. Opt-in requires allow_remote_bg=true, PHP cURL with HTTPS support, and a nonempty bg_domains array of valid ASCII domains (exact or subdomain match). Missing or invalid lists return 403; missing cURL returns 503. Prefer HTTPS port 443. Preview is stateless, ignores all backgrounds, and is capped at 480x200 and 5 frames. Rotating a key creates a new UID scope.",

    "tk_master_CHANGE_ME": {
        "name": "Master",
        "limit": 0,
        "active": true
    },
    "tk_free_EXAMPLE": {
        "name": "Free tier example",
        "limit": 1000,
        "active": true,
        "max_width": 640,
        "max_height": 200,
        "max_seconds": 30
    },
    "tk_pro_EXAMPLE": {
        "name": "Pro tier with allowlisted bg domains",
        "limit": 100000,
        "active": true,
        "max_width": 1200,
        "max_height": 400,
        "max_seconds": 120,
        "allow_remote_bg": true,
        "bg_domains": ["images.example.com", "cdn.mycompany.com"]
    }
}
