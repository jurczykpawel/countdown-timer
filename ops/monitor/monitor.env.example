# Copy outside the repository to /etc/countdown-timer/monitor.env, mode 0600.
# Plain KEY=value data: no export, quotes, interpolation or inline comments.
LOG_FILE=/var/log/timer-gif-cleanup.log
STATE_DIR=/var/lib/countdown-timer
CACHE_ROOT=/var/cache/timer-gif
STALE_SECONDS=3900
UID_FILES_WARNING=100000
UID_FILES_CRITICAL=500000
INODE_PERCENT_WARNING=60
INODE_PERCENT_CRITICAL=75
DISK_PERCENT_WARNING=70
DISK_PERCENT_CRITICAL=85
UID_DAILY_GROWTH_WARNING=10000
# ntfy-compatible POST endpoints. Empty URL disables that channel.
PRIMARY_URL=https://notify.example.com/replace-primary-topic
PRIMARY_TOKEN=REPLACE_WITH_PRIMARY_TOKEN
PRIMARY_TIMEOUT=20
SECONDARY_URL=
SECONDARY_TOKEN=
SECONDARY_TIMEOUT=10
